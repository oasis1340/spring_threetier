<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.threetier.mapper.TaskMapper">
    <insert id="insert" parameterType="TaskVO">
        INSERT INTO TBL_TASK
        VALUES (SEQ_TASK.NEXTVAL, #{name}, #{kor}, #{eng}, #{math})
    </insert>

    <select id="total" resultType="TaskDTO">
        SELECT ID, NAME, KOR, ENG, MATH, (KOR + ENG + MATH) AS TOTAL, AVG(KOR + ENG + MATH) AS AVERAGE
        FROM TBL_TASK
    </select>

</mapper>